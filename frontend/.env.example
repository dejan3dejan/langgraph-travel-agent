# Backend API base URL, baked into the build by Vite at build time (not read at runtime).
#
# Leave empty for local development: the Vite dev server proxies /api and /health to the
# backend on :8000 (see vite.config.js), so no base URL is needed.
#
# In production the static frontend has no proxy, so set this to the backend origin, with no
# trailing slash and no /api suffix. Example:
#   VITE_API_URL=https://atlas-api.up.railway.app
VITE_API_URL=

# PostHog product analytics. Leave both empty to disable: with no write key, analytics is a hard
# no-op (nothing loads, nothing is sent), which is what local dev, tests, and CI want. Even with a
# key set, nothing is tracked until the user grants consent in the banner.
#
# VITE_POSTHOG_KEY is the project write key (phc_...), public by design. VITE_POSTHOG_HOST is the
# ingestion host; it defaults to PostHog EU cloud. Point it at your self-hosted instance or US cloud
# (https://us.i.posthog.com) if that is where the project lives. The event taxonomy is documented in
# src/analytics.md.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
