# OpenAI API Key (primary LLM + embeddings provider)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (kept as fallback)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
# Local development example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_companion

# API Authentication (leave empty to disable auth in dev mode)
API_KEY=

# Deployment environment. Set to "production" on a real host: this makes the app refuse to
# start unless JWT_SECRET_KEY is set to a real value (a missing/default secret signs forgeable
# tokens). Leave as "development" locally.
ENVIRONMENT=development

# JWT Secret Key for user authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production
JWT_EXPIRE_MINUTES=1440

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting — max requests per IP per window
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# Transactional email (verification + password reset). Leave RESEND_API_KEY empty in dev: sending
# degrades to a logged no-op so signup and reset still work without a provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# The verified sender. Use Resend's onboarding@resend.dev to test, your own domain in production.
EMAIL_FROM=Atlas <onboarding@resend.dev>
# Public origin the app is served from, used to build the links in emails.
APP_BASE_URL=http://localhost:5173
# Token lifetimes.
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# Local-only: with no provider configured, echo the email link to the log so you can complete the
# flow by hand. Never enable in a shared environment; the link carries a single-use token.
EMAIL_DEV_ECHO=false
# Per-email cap on mail-sending endpoints (forgot-password, resend-verification) so they cannot be
# used to flood an inbox. Max sends per email per window (seconds).
EMAIL_SEND_MAX=3
EMAIL_SEND_WINDOW=3600
